# ── LLM Provider 切换 ──
# 主 LLM 提供方: deepseek | ollama | qwen   默认 deepseek
LLM_PROVIDER=deepseek
# 主 LLM 不可用时的降级顺序（逗号分隔）；为空则不降级，最终回退到 mock
LLM_FALLBACK_CHAIN=ollama,qwen

# ── DeepSeek LLM ──
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ── 千问 (Qwen / DashScope) ──
# 通过 DashScope OpenAI 兼容接口，模型可选 qwen-plus / qwen-turbo / qwen-max / qwen-long
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# ── Ollama (local) ──
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:0.8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest

# ── Rerank ──
RERANK_MODEL_NAME=BAAI/bge-reranker-base

# ── Milvus ──
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=policy_knowledge
MILVUS_DIM=768

# ── Postgres ──
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=policy_agent

# ── JWT ──
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=1440

# ── Default Admin ──
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin


POLICY_AGENT_MOCK_LLM=False
